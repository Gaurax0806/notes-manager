<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Note</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="form-page">
        <div class="form-card">

            <h1>✏️ Edit Note</h1>

            <form action="/edit/<%= note._id %>" method="POST" enctype="multipart/form-data">

                <label>Title</label>
                <input
                    type="text"
                    name="title"
                    value="<%= note.title %>"
                    required
                >

                <label>Content</label>
                <textarea name="content" required><%= note.content %></textarea>

                <label>Upload New PDF (replaces existing if any)</label>
                <input
                    type="file"
                    name="pdf"
                    accept=".pdf"
                >

                <% if(note.pdf){ %>
                    <div style="margin-top: 10px;">
                        <a href="<%= note.pdf %>" target="_blank" class="pdf-btn">📄 View Current PDF</a>
                    </div>
                <% } %>

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn">💾 Save Changes</button>
                    <a href="/" class="btn secondary">← Cancel</a>
                </div>

            </form>
        </div>
    </div>

</body>
</html>
