<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Note - Notes Manager</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="form-page">
        <div class="form-card">

            <h1>✏️ Edit Note</h1>

            <form action="/edit/<%= note._id %>" method="POST" enctype="multipart/form-data">

                <label>Title</label>
                <input
                    type="text"
                    name="title"
                    value="<%= note.title %>"
                    required
                >

                <label>Category</label>
                <select name="category" style="width: 100%; padding: 14px 18px; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 14px; margin-bottom: 22px; font-size: 1rem; background: rgba(15, 23, 42, 0.7); color: #f8fafc; font-family: inherit;">
                    <option value="General" <%= note.category === 'General' ? 'selected' : '' %> style="background: #0f172a; color: #f8fafc;">General</option>
                    <option value="Study" <%= note.category === 'Study' ? 'selected' : '' %> style="background: #0f172a; color: #f8fafc;">Study</option>
                    <option value="Work" <%= note.category === 'Work' ? 'selected' : '' %> style="background: #0f172a; color: #f8fafc;">Work</option>
                    <option value="Personal" <%= note.category === 'Personal' ? 'selected' : '' %> style="background: #0f172a; color: #f8fafc;">Personal</option>
                    <option value="Ideas" <%= note.category === 'Ideas' ? 'selected' : '' %> style="background: #0f172a; color: #f8fafc;">Ideas</option>
                </select>

                <label>Content</label>
                <textarea name="content" required><%= note.content %></textarea>

                <label>Upload New PDF (replaces existing if any)</label>
                <input
                    type="file"
                    name="pdf"
                    accept=".pdf"
                >

                <% if(note.pdf){ %>
                    <div style="margin-top: 10px; margin-bottom: 15px;">
                        <a href="<%= note.pdf %>" target="_blank" class="pdf-btn">📄 View Current PDF</a>
                    </div>
                <% } %>

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn">💾 Save Changes</button>
                    <a href="/" class="btn secondary">← Cancel</a>
                </div>

            </form>
        </div>
    </div>

</body>
</html>
