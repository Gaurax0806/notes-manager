<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Notes Manager</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="form-page">
        <div class="form-card">
            <h1>🚀 Create Account</h1>
            <p>Sign up to start organizing your notes securely.</p>

            <% if(typeof error !== 'undefined' && error) { %>
                <div style="background: rgba(239,68,68,0.15); color: #fca5v5; border: 1px solid rgba(239,68,68,0.3); padding: 12px; border-radius: 10px; margin-bottom: 20px; font-weight: 600;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/signup" method="POST">
                <label>Username</label>
                <input type="text" name="username" placeholder="e.g. gaurav_08" required>

                <label>Email</label>
                <input type="email" name="email" placeholder="e.g. gaurav@example.com" required>

                <label>Password</label>
                <input type="password" name="password" placeholder="At least 6 characters" required>

                <div class="form-actions">
                    <button type="submit" class="btn">Sign Up</button>
                    <a href="/login" class="btn secondary">Already have an account? Login</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
