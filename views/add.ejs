<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Note - Notes Manager</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <div class="form-page">
        <div class="form-card">
            <h1>📝 Add New Note</h1>
            <p>Write down something important before you forget it.</p>

            <form action="/add" method="POST" enctype="multipart/form-data">
                <label>Title</label>
                <input
                    type="text"
                    name="title"
                    placeholder="e.g. DBMS Unit 1"
                    required
                />

                <label>Category</label>
                <select name="category" style="width: 100%; padding: 14px 18px; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 14px; margin-bottom: 22px; font-size: 1rem; background: rgba(15, 23, 42, 0.7); color: #f8fafc; font-family: inherit;">
                    <option value="General" style="background: #0f172a; color: #f8fafc;">General</option>
                    <option value="Study" style="background: #0f172a; color: #f8fafc;">Study</option>
                    <option value="Work" style="background: #0f172a; color: #f8fafc;">Work</option>
                    <option value="Personal" style="background: #0f172a; color: #f8fafc;">Personal</option>
                    <option value="Ideas" style="background: #0f172a; color: #f8fafc;">Ideas</option>
                </select>

                <label>Content</label>
                <textarea
                    name="content"
                    placeholder="Write your note here..."
                    required
                ></textarea>

                <label>Upload PDF (optional)</label>
                <input
                    type="file"
                    name="pdf"
                    accept=".pdf"
                >

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn">💾 Save Note</button>
                    <a href="/" class="btn secondary">← Back</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
